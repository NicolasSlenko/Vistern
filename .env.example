# Copy to .env.local and supply development credentials. Never commit real values.
# NEXT_PUBLIC_ variables reach the browser; keep secret keys server-side.

# --- AI provider (src/lib/ai) ---
# Default provider for users who haven't picked one in Settings: hipergator | openai | claude
AI_PROVIDER="hipergator"
# Requests per user per day on paid providers (OpenAI / Claude); then they fall back to HiPerGator.
PAID_AI_DAILY_LIMIT="20"

# UF HiPerGator / NaviGator (OpenAI-compatible LiteLLM proxy). Free through UF.
HIPERGATOR_API_KEY="your-hipergator-key"
HIPERGATOR_BASE_URL="https://api.ai.it.ufl.edu/v1"
HIPERGATOR_MODEL="gemma-4-31b-it"
# Pick an embedding model from GET /v1/models; required for Match page live jobs.
HIPERGATOR_EMBEDDING_MODEL=""
# Optional: USD per 1M tokens, so cost logs include HiPerGator. Leave unset to log tokens only.
# HIPERGATOR_PRICE_INPUT="0"
# HIPERGATOR_PRICE_OUTPUT="0"

# OpenAI (paid). Leave the key empty to hide it from the model picker.
# Also used for embeddings when AI_PROVIDER is openai or claude (Claude has no embeddings API).
OPENAI_API_KEY="your-development-openai-key"
# OPENAI_MODEL="gpt-6-luna"

# Anthropic Claude (paid). Leave the key empty to hide it from the model picker.
ANTHROPIC_API_KEY="your-anthropic-key"
# CLAUDE_MODEL="claude-haiku-5-5"

# Clerk sign-in. The publishable key is browser-safe; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Private S3 bucket for uploaded resume files and remaining legacy records.
# Set the region to the region of the bucket used by this environment.
AWS_BUCKET_REGION=
AWS_BUCKET_NAME=
# Developer credentials with access limited to the required bucket.
IAM_AWS_ACCESS_KEY=
IAM_AWS_SECRET_ACCESS_KEY=

# Adzuna credentials for live job listings on the match page.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reserved for model experiments; the current application code does not read these.
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=

# Supabase project used for structured student data. These values are browser-safe
# only while the project's row-level security policies are correctly configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved placeholder; the current application code does not read SUPABASE_KEY.
# Never put a Supabase secret or service-role key in a NEXT_PUBLIC_ variable.
SUPABASE_KEY=

# Optional local Drizzle tooling only; the running app stores structured data in Supabase.
DB_FILE_NAME=

# Optional owner account ID for development AI usage-limit bypass.
OWNER_CLERK_USER_ID=
