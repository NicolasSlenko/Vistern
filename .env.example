# Copy this file to .env.local and fill in development credentials.
# Never commit .env.local or paste server-side credentials into Slack.

# --- AI provider (src/lib/ai) ---
# Default provider for users who haven't picked one in Settings: hipergator | openai | claude
AI_PROVIDER="hipergator"
# Requests per user per day on paid providers (OpenAI / Claude); then they fall back to HiPerGator.
PAID_AI_DAILY_LIMIT="20"

# UF HiPerGator / NaviGator (OpenAI-compatible LiteLLM proxy). Free through UF.
HIPERGATOR_API_KEY="your-hipergator-key"
HIPERGATOR_BASE_URL="https://api.ai.it.ufl.edu/v1"
HIPERGATOR_MODEL="gemma-4-31b-it"
# Pick an embedding model from GET /v1/models; required for Match page live jobs.
HIPERGATOR_EMBEDDING_MODEL=""
# Optional: USD per 1M tokens, so cost logs include HiPerGator. Leave unset to log tokens only.
# HIPERGATOR_PRICE_INPUT="0"
# HIPERGATOR_PRICE_OUTPUT="0"

# OpenAI (paid). Leave the key empty to hide it from the model picker.
# Also used for embeddings when AI_PROVIDER is openai or claude (Claude has no embeddings API).
OPENAI_API_KEY="your-development-openai-key"
# OPENAI_MODEL="gpt-6-luna"

# Anthropic Claude (paid). Leave the key empty to hide it from the model picker.
ANTHROPIC_API_KEY="your-anthropic-key"
# CLAUDE_MODEL="claude-haiku-5-5"

# --- Adzuna (live job listings for the Match page) ---
# Get free API keys at: https://developer.adzuna.com/
ADZUNA_APP_ID="your-app-id"
ADZUNA_APP_KEY="your-app-key"

# Only used by legacy Drizzle tooling; app data is stored in Supabase.
DB_FILE_NAME="file:local.db"

# --- AWS S3 (uploaded resume files only) ---
AWS_BUCKET_NAME="your-bucket-name"
# Vistern's bucket is in us-east-2. Change this if using a separate dev bucket.
AWS_BUCKET_REGION="us-east-2"
# Use individual developer credentials scoped to the bucket they need.
IAM_AWS_ACCESS_KEY="your-development-access-key-id"
IAM_AWS_SECRET_ACCESS_KEY="your-development-secret-access-key"

# --- Clerk (authentication) ---
# Public key used on the client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Secret key used on the server (API routes)
CLERK_SECRET_KEY="sk_test_..."

# --- Owner exemption (rate limits) ---
# Set this to your Clerk user ID (found in Clerk dashboard > Users) to bypass daily AI usage limits
OWNER_CLERK_USER_ID="user_..."

# --- Supabase (structured app data; Clerk still handles authentication) ---
# The URL and publishable key are client-safe when table RLS is configured.
# Do not use SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL="https://scfipntavlfolmmeiszi.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
