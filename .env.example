# Copy to .env.local and supply development credentials. Never commit real values.
# NEXT_PUBLIC_ variables reach the browser; keep secret keys server-side.

# AI used to parse resumes and generate review feedback. The OpenAI SDK reads this key.
OPENAI_API_KEY=

# Clerk sign-in. The publishable key is browser-safe; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Private S3 bucket for uploaded resume files and remaining legacy records.
# Set the region to the region of the bucket used by this environment.
AWS_BUCKET_REGION=
AWS_BUCKET_NAME=
# Developer credentials with access limited to the required bucket.
IAM_AWS_ACCESS_KEY=
IAM_AWS_SECRET_ACCESS_KEY=

# Adzuna credentials for live job listings on the match page.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reserved for model experiments; the current application code does not read these.
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=

# Supabase project used for structured student data. These values are browser-safe
# only while the project's row-level security policies are correctly configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved placeholder; the current application code does not read SUPABASE_KEY.
# Never put a Supabase secret or service-role key in a NEXT_PUBLIC_ variable.
SUPABASE_KEY=

# Optional local Drizzle tooling only; the running app stores structured data in Supabase.
DB_FILE_NAME=

# Optional owner account ID for development AI usage-limit bypass.
OWNER_CLERK_USER_ID=
